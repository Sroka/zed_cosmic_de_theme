[Unit]
Description=Watch the COSMIC desktop theme and keep the Zed theme in sync

[Path]
PathChanged=%h/.config/cosmic/com.system76.CosmicTheme.Mode/v1
PathChanged=%h/.config/cosmic/com.system76.CosmicTheme.Dark/v1
PathChanged=%h/.config/cosmic/com.system76.CosmicTheme.Light/v1
PathChanged=%h/.config/zed-cosmic-theme/config.json
TriggerLimitIntervalSec=2s
TriggerLimitBurst=50

[Install]
WantedBy=default.target
